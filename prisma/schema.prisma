generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model JobRequest {
  id               String  @id @default(cuid())
  ownerCompanyId   String
  title            String
  jobType          String
  commodity        String
  urgency          String
  scopeDescription String
  descriptionFull  String
  status           String

  startDate        DateTime?
  expectedDuration String?

  address   String
  city      String
  state     String
  latitude  Float
  longitude Float

  complianceRequirements String[]

  equipmentNotes String?
  laborNotes     String?

  pricingExpectation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos    JobPhoto[]
  documents JobDocument[]

  @@index([status])
  @@index([ownerCompanyId])
}

model JobPhoto {
  id           String   @id @default(cuid())
  jobRequestId String
  s3Key        String
  label        String
  createdAt    DateTime @default(now())

  jobRequest JobRequest @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)

  @@index([jobRequestId])
}

model JobDocument {
  id           String   @id @default(cuid())
  jobRequestId String
  s3Key        String
  name         String
  kind         String
  createdAt    DateTime @default(now())

  jobRequest JobRequest @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)

  @@index([jobRequestId])
}
